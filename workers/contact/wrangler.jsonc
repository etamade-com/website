{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "etamade-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  // Only the Pages service binding can reach this Worker.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CONTACT_ENABLED": "false",
    "CONTACT_FROM": "website@forms.etamade.com",
    // Change BOTH CONTACT_TO and destination_address to your verified inbox.
    "CONTACT_TO": "contact@etamade.com",
    "ALLOWED_ORIGINS": "https://etamade.com,https://etamade.ro"
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "contact@etamade.com" }
  ],
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "454793461",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "EMAIL_LIMITER",
      "namespace_id": "454793462",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
  // Store TURNSTILE_SECRET_KEY and RATE_LIMIT_SALT with `wrangler secret put`.
  // Never add them to vars or source control.
}
